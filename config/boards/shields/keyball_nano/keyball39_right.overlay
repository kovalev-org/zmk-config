#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <input/processors.dtsi>

#include "keyball39.dtsi"

&default_transform {
    col-offset = <6>;
};

&kscan0 {
	col-gpios
		= <&pro_micro 4 GPIO_ACTIVE_HIGH>
		, <&pro_micro 5 GPIO_ACTIVE_HIGH>
		, <&pro_micro 6 GPIO_ACTIVE_HIGH>
		, <&pro_micro 7 GPIO_ACTIVE_HIGH>
		, <&pro_micro 8 GPIO_ACTIVE_HIGH>
        , <&pro_micro 9 GPIO_ACTIVE_HIGH>
		;
};

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                <NRF_PSEL(SPIM_MISO, 0, 10)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                <NRF_PSEL(SPIM_MISO, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi1 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    // Community PMW3610 driver (mochukeeb/zmk-pmw3610-driver, pinned in
    // config/west.yml) — the exact driver + settings used by the reference
    // Keyball39 config whose trackball tracks correctly. All sensor tuning
    // (CPI, CPI divisor, orientation, smart algorithm, polling rate,
    // downshift/rest timings, scroll direction) lives in keyball39_right.conf
    // as CONFIG_PMW3610_* — this driver takes its knobs from Kconfig, not DT
    // properties (the native pixart,pmw3610 driver was the opposite). The
    // hardware wiring (SPI pins, CS on gpio0 9, motion IRQ on gpio1 11) is
    // identical to the native-driver setup; only the `compatible` and the
    // IRQ property name (`irq-gpios`, not `motion-gpios`) differ.
    trackball: trackball@0 {
        status = "okay";
        compatible = "zmk,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        // Scroll on the Nav layer (index 1): while LH1 (&lt_spc NAV 0) is held
        // the driver emits wheel events instead of cursor motion, so rolling
        // the ball scrolls. Matches the pre-existing scroll-on-Nav behavior.
        // (No `snipe-layers`/`arrows` — those map to layers the reference
        // keymap has but this one doesn't. No `automouse-layer` — auto-mouse
        // is handled by &zip_temp_layer in the listener below; see west.yml
        // for why the driver's built-in automouse can't compile on ZMK main.)
        scroll-layers = <1>;
    };
};

// Each &mkp press (LCLK/MCLK/RCLK on the Mouse layer) re-arms the Mouse
// layer's deactivation timer to 500 ms, so a multi-click (double-/triple-
// click) keeps the layer alive and it deactivates 500 ms after the last
// click — comfortably inside the OS double-click window (250–500 ms).
// `zip_temp_layer` keys its disable work on the layer index and reschedules
// on each event, so this 500 ms schedule and the trackball listener's
// 3000 ms one below don't conflict; whichever fires latest wins.
&mkp_input_listener {
    input-processors = <&zip_temp_layer 5 500>;
};

/ {
    // This unit's trackball reports ~3x fewer counts vertically (REL_Y) than
    // horizontally, so with the driver's symmetric CPI_DIVIDOR the vertical
    // cursor came out ~3x too slow while horizontal felt right. Boost REL_Y
    // by 3x to rebalance. This scaler ONLY touches REL_Y, so horizontal (REL_X)
    // and scroll (REL_WHEEL/HWHEEL) are untouched. track-remainders preserves
    // fractional counts, so if 3x is retuned to a non-integer ratio later
    // (e.g. <5 2> = 2.5x) slow vertical motion still won't round away.
    zip_y_boost: zip_y_boost {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_Y>;
        track-remainders;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        // Auto-mouse: any cursor-motion event (REL_X/REL_Y — the community
        // driver emits these in its default MOVE mode) activates the Mouse
        // layer (index 5) for 3000 ms, turning the right-hand/thumb keys into
        // mouse buttons after you touch the ball. Auto-deactivates 3 s after
        // the last motion (or 500 ms after the last click, via
        // &mkp_input_listener above). The driver sets overall speed internally
        // (CONFIG_PMW3610_CPI 1200 ÷ CONFIG_PMW3610_CPI_DIVIDOR 4 ≈ 300
        // effective CPI); &zip_y_boost only rebalances the vertical axis.
        input-processors = <&zip_temp_layer 5 3000 &zip_y_boost 3 1>;

        // Nav layer (index 1) = scroll. The sensor node already remaps motion
        // to wheel events on this layer (scroll-layers = <1>), so this override
        // REPLACES the auto-mouse chain with nothing: an empty processor list
        // plus process-next defaulting to false means the base chain is skipped
        // (see input_listener.c:filter_with_input_config — a matched override
        // returns before apply_config(base)). Without it the wheel events would
        // trip &zip_temp_layer, flip on the Mouse layer, and the driver —
        // seeing Mouse (5) as the highest active layer rather than Nav (1) —
        // would revert to cursor mode mid-scroll.
        scroll {
            layers = <1>;
        };
    };
};
